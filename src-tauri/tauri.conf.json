{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Soft Explorer",
  "mainBinaryName": "soft-explorer",
  "version": "1.0.1",
  "identifier": "local.softexplorer.manga",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Soft Explorer",
        "width": 1440,
        "height": 920,
        "minWidth": 640,
        "minHeight": 560,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      },
      "csp": "default-src 'self' asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "wix": {
        "upgradeCode": "8f92cf54-fee5-5b0e-81b6-8d036104a15d"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Tu manga, tu espacio.",
    "longDescription": "Organiza y lee tu colección local sin conexión."
  }
}
